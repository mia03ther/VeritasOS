PORT=4000
DATABASE_URL=file:./dev.db

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MODEL_VERSION=
VERDICT_STORE_PATH=backend/data/verdicts.jsonl
# Set to jsonl for the isolated fixture-backed agent demo.
ARBITRA_PERSISTENCE=prisma

ARBITER_RPC_URL=
ARBITER_ESCROW_ADDRESS=
ARBITER_ORACLE_PRIVATE_KEY=

ARBITRA_INTERNAL_KEY=

# Trust Intelligence: server-only credentials; never put these in NEXT_PUBLIC_*.
NANSEN_API_KEY=
NANSEN_BASE_URL=https://api.nansen.ai/api/v1
# Supported by this adapter: monad (mainnet intelligence), ethereum.
# Nansen intelligence chain is independent of escrow execution/testnet.
NANSEN_CHAIN=monad
MOCK_NANSEN=false
MOCK_TRUST_LLM=false

# Optional MCP/The Graph configuration. The MCP service falls back to Prisma-backed APIs when unset.
GRAPH_ENDPOINT=
GRAPH_API_KEY=
